# Configuration template only. Supply values through local ignored files or hosting secrets.
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
# Comma-separated verified recipients allowed outside pilot/production.
EMAIL_TEST_ALLOWLIST=
CRON_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
TUTOR_MONTHLY_BUDGET_USD=10
TUTOR_INPUT_USD_PER_MILLION=0.25
TUTOR_OUTPUT_USD_PER_MILLION=2.00
CERTIFICATE_ISSUER=PGLearn
# Real uploads max 1 GiB; provider bucket configuration must permit this size.
SUPABASE_STORAGE_BUCKET=pglearn-private
